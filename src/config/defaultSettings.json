{
  "theme": {
    "darkMode": false,
    "primaryColor": "#1677ff",
    "colorWeak": false,
    "grayMode": false,
    "compactMode": false,
    "fontSize": 14,
    "borderRadius": 6,
    "sidebarDark": false
  },
  "layout": {
    "layoutMode": "mix",
    "collapsed": false,
    "sidebarWidth": 208,
    "showHeader": true,
    "fixedHeader": true,
    "showSidebar": true,
    "fixedSidebar": true,
    "showFooter": true,
    "showBreadcrumb": true,
    "contentWidth": "fluid",
    "menuAccordion": false,
    "sideMenuType": "sub",
    "contentPadding": 24
  },
  "header": {
    "actionVisibility": {
      "menuSearch": true,
      "notification": true,
      "language": true,
      "darkMode": true,
      "fullscreen": false,
      "lockScreen": true
    },
    "actionOrder": {
      "primary": ["menuSearch", "notification"],
      "utility": ["language", "darkMode", "fullscreen", "lockScreen"]
    },
    "showUserName": true
  },
  "tabs": {
    "showTabs": true,
    "tabStyle": "card",
    "maxTabs": 0,
    "restoreTabs": true,
    "showTabIcon": false
  },
  "transition": {
    "enableTransition": true,
    "transitionName": "fade",
    "motionPreference": "system",
    "animationSpeed": "standard"
  },
  "form": {
    "formDisplayMode": "drawer",
    "formColumns": 1,
    "formSizePreset": "medium",
    "formLabelAlign": "right",
    "formComponentSize": "middle",
    "formColon": true,
    "formLayout": "vertical",
    "formDrawerPlacement": "right",
    "formLabelWidth": 100
  },
  "system": {
    "systemName": "ZX Admin",
    "systemLogo": "https://gw.alipayobjects.com/zos/rmsportal/KDpgvguMpGfqaHPjicRK.svg",
    "showWatermark": false,
    "watermarkText": ""
  },
  "table": {
    "tableSize": "large",
    "tableBordered": false,
    "tableResizable": false,
    "tableStriped": false,
    "tableDefaultPageSize": 20,
    "tableShowIndex": false,
    "tableFixedHeader": false,
    "tableMaxHeight": 600,
    "tableShowSizeChanger": true,
    "tableShowQuickJumper": true,
    "tableShowTotal": false,
    "tablePaginationPosition": "right",
    "tableRememberColumnWidths": false
  }
}
